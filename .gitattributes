# Normalize line endings: LF in the repo and in the working copy, on every OS.
# Stops "LF will be replaced by CRLF" warnings caused by core.autocrlf=true.
* text=auto eol=lf

# Windows scripts must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icoclear binary
