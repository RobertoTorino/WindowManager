# Writes a header with the build number, commit and date.
#
#   cmake -DOUT=<header> -DSOURCE_DIR=<repo> -P cmake/BuildInfo.cmake
#
# Runs on every build. The header is only rewritten when its content changes (new commit, new day),
# so nothing recompiles needlessly.
#
# Build number: the CI run number when built by GitHub Actions, otherwise the number of commits.
string(TIMESTAMP BUILD_DATE "%Y-%m-%d")

set(BUILD_NUMBER "0")
set(BUILD_HASH "unknown")

find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-list --count HEAD
                    OUTPUT_VARIABLE git_count OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE git_count_rc)
    if(git_count_rc EQUAL 0 AND NOT git_count STREQUAL "")
        set(BUILD_NUMBER "${git_count}")
    endif()

    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short HEAD
                    OUTPUT_VARIABLE git_hash OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE git_hash_rc)
    if(git_hash_rc EQUAL 0 AND NOT git_hash STREQUAL "")
        set(BUILD_HASH "${git_hash}")
        # a "+" marks a build with uncommitted changes
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE git_dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT git_dirty STREQUAL "")
            set(BUILD_HASH "${BUILD_HASH}+")
        endif()
    endif()
endif()

if(DEFINED ENV{GITHUB_RUN_NUMBER} AND NOT "$ENV{GITHUB_RUN_NUMBER}" STREQUAL "")
    set(BUILD_NUMBER "$ENV{GITHUB_RUN_NUMBER}")
endif()

set(content "// Generated by cmake/BuildInfo.cmake - do not edit.
#pragma once
#define APP_BUILD_NUMBER \"${BUILD_NUMBER}\"
#define APP_BUILD_HASH \"${BUILD_HASH}\"
#define APP_BUILD_DATE \"${BUILD_DATE}\"
")

set(existing "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
endif()
if(NOT existing STREQUAL content)
    get_filename_component(out_dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${OUT}" "${content}")
endif()
